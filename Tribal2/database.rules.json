{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "villages": {
      "$villageId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() === auth.uid)"
      }
    },
    "map": {
      ".read": "auth != null",
      "$tile": {
        ".write": "auth != null"
      }
    },
    "movements": {
      ".read": "auth != null",
      ".indexOn": ["resolved"],
      "$movementId": {
        ".write": "auth != null && (!data.exists() || data.child('originOwnerId').val() === auth.uid || data.child('targetOwnerId').val() === auth.uid)"
      }
    },
    "reports": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "banners": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },
    "events": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "raidMovements": {
      ".read": "auth != null",
      ".indexOn": ["resolved"],
      "$movementId": {
        ".write": "auth != null"
      }
    },
    "supportStacks": {
      ".read": "auth != null",
      "$targetUid": {
        "$sourceUid": {
          ".write": "auth != null"
        }
      }
    },
    "globalFeed": {
      ".read": "auth != null",
      "$entryId": {
        ".write": "auth != null"
      }
    }
  }
}
